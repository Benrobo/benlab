{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "packaging-waste-dataset",
  "account_id": "a6648d365ae221df74fdff4e57e3d7a3",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },
  "vars": { "ENGINE_URL": "https://packaging-waste-dataset.api.benlab.space" },
  "ratelimits": [
    { "name": "UPLOAD_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "REMOVE_LIMIT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "CATEGORY_LIMIT", "namespace_id": "1004", "simple": { "limit": 3, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "1006", "simple": { "limit": 120, "period": 60 } }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Engine"] },
    { "tag": "v2", "deleted_classes": ["Engine"] }
  ],
  "routes": [{ "pattern": "packaging-waste-dataset.benlab.space", "custom_domain": true }]
}
