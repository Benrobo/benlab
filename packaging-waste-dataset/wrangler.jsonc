{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "packaging-waste-dataset",
  "account_id": "a6648d365ae221df74fdff4e57e3d7a3",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },
  "containers": [
    {
      "class_name": "Engine",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ENGINE", "class_name": "Engine" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Engine"] }],
  "routes": [{ "pattern": "packaging-waste-dataset.benlab.space", "custom_domain": true }]
}
